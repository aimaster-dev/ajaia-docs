{
  // Compiles the server to dist/server (and shared types to dist/shared) for production.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/server", "src/shared"],
  "exclude": ["src/server/dev.ts"]
}
