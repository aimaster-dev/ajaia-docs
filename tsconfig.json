{
  // Server, shared types, tests and scripts. The client has its own config in src/client.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/server", "src/shared", "tests", "scripts", "vite.config.ts", "vitest.config.ts"]
}
